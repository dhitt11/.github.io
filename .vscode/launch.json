{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Live Server",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/index.html",
            "serverReadyAction": {
                "pattern": "Server is running on port ([0-9]+)",
                "uriFormat": "http://localhost:%s",
                "action": "openExternally"
            }
        },
        {
            "name": "Open in Browser",
            "type": "chrome",
            "request": "launch",
            "file": "${workspaceFolder}/index.html"
        }
    ]
}